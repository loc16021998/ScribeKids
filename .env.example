# Sao chép thành .env.local và điền giá trị từ Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (Dự án cũ có thể dùng anon key thay cho publishable key)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CHỈ dùng ở server (ghi điểm AI). Không bao giờ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Claude API cho module chấm điểm (lib/ai/vlm.ts) — chỉ dùng ở server.
ANTHROPIC_API_KEY=sk-ant-xxx
